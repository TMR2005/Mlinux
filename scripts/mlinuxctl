#!/usr/bin/env bash

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VENV_BIN="$(which python3)"

cmd="$1"
shift || true

case "$cmd" in
  dash)
    exec "$VENV_BIN" "$PROJECT_DIR/system/ml_dashboard.py" "$@"
    ;;
  graph)
    exec "$VENV_BIN" "$PROJECT_DIR/system/ml_gpu_graph.py" "$@"
    ;;
  advise)
    exec "$VENV_BIN" "$PROJECT_DIR/system/ml_advisor.py" "$@"
    ;;
  stats)
    tail -n 1 "$PROJECT_DIR/metrics.log"
    ;;
  summary)
    exec "$VENV_BIN" "$PROJECT_DIR/system/ml_summary.py"
    ;;
  sched)
    exec "$VENV_BIN" "$PROJECT_DIR/system/ml_sched.py"
    ;;
  *)
    echo "mlinuxctl - MLinux control tool"
    echo "Usage:"
    echo "  mlinuxctl dash"
    echo "  mlinuxctl graph"
    echo "  mlinuxctl advise"
    echo "  mlinuxctl stats"
    echo "  mlinuxctl summary"
    echo "  mlinuxctl sched     # scheduler diagnostics"
    exit 1
    ;;
esac
